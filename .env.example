# Prisma - self-hosted Supabase Postgres runtime connection.
# This is the application source of truth. Do not point production at a managed
# Supabase project unless the architecture decision is explicitly revisited.
DATABASE_URL="postgresql://greyhoundiq_app:YOUR_DB_PASSWORD@postgres:5432/greyhoundiq?schema=public&connection_limit=5&pool_timeout=10&connect_timeout=15"

# Optional dedicated connection string for bulk archive replay scripts. If set,
# import jobs use this instead of the app runtime DATABASE_URL. It must point at
# the same self-hosted Supabase/Postgres cluster using an import-scoped role.
DATABASE_IMPORT_URL="postgresql://greyhoundiq_import:YOUR_DB_PASSWORD@postgres:5432/greyhoundiq?schema=public&connection_limit=2&pool_timeout=30&connect_timeout=15"
DATABASE_IMPORT_CONNECTION_LIMIT="1"
DATABASE_IMPORT_POOL_TIMEOUT="60"
DATABASE_IMPORT_CONNECT_TIMEOUT="30"

# Optional direct/session connection for Prisma CLI operations. Use a migrator
# role against the same self-hosted database. Do not use it for broad imports.
DIRECT_URL="postgresql://greyhoundiq_migrator:YOUR_DB_PASSWORD@postgres:5432/greyhoundiq?schema=public&connect_timeout=15"

# Self-hosted Supabase API values for Storage/Realtime. The app database still
# uses DATABASE_URL through Prisma. Never expose the service-role key to the browser.
SUPABASE_URL="https://supabase.your-domain.example"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
NEXT_PUBLIC_SUPABASE_URL="https://supabase.your-domain.example"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Media maintenance. Production defaults to disabled unless a scanner is wired.
# metadata is acceptable for local/staging smoke only; do not treat it as AV.
# clamav requires clamscan plus virus definitions and should run on a dedicated
# scanner service/job with enough memory, not the default 1Gi web service.
MEDIA_SCAN_MODE="disabled"
MEDIA_CLAMSCAN_BIN="clamscan"
MEDIA_CLAMAV_DATABASE=""
MEDIA_CLAMSCAN_TIMEOUT_MS="120000"

# App URL and server-side signing secret.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_SECRET="optional-same-value-as-NEXTAUTH_SECRET"

# WorkOS AuthKit
WORKOS_CLIENT_ID="client_YOUR_WORKOS_CLIENT_ID"
WORKOS_API_KEY="sk_test_YOUR_WORKOS_API_KEY"
WORKOS_COOKIE_PASSWORD="generate-at-least-32-characters"
WORKOS_COOKIE_DOMAIN=""
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/callback"

# Lago app integration. Required for production billing and metering flows.
# Keep API keys and webhook secrets server-only.
LAGO_API_URL="https://your-lago-api.example.com"
LAGO_FRONT_URL="https://your-lago.example.com"
LAGO_API_KEY="generate-with-lago-production-api-key"
LAGO_WEBHOOK_SECRET="generate-with-openssl-rand-base64-32"

# Internal maintenance routes. Send this as the X-Internal-Secret header.
# Cloud Scheduler sends CRON_SECRET as Authorization: Bearer <secret>.
INTERNAL_API_SECRET="generate-with-openssl-rand-base64-32"
CRON_SECRET="generate-with-openssl-rand-base64-32"

# Optional notification delivery webhook. Leave unset for in-app only.
NOTIFICATION_WEBHOOK_URL=""
NOTIFICATION_WEBHOOK_SECRET=""
NOTIFICATION_DELIVERY_MAX_ATTEMPTS="5"

# Optional live racing feed
TOPAZ_API_KEY=""
TOPAZ_API_BASE="https://topaz.grv.org.au/api"
TOPAZ_OWNING_AUTHORITY_CODE="VIC"
TOPAZ_TIME_ZONE="Australia/Sydney"

# Public all-Australia racecard source used for pre-production and live coverage
# verification. It covers national fields without replacing licensed feeds.
THEDOGS_PROVIDER_ENABLED="true"
THEDOGS_BASE_URL="https://www.thedogs.com.au"
THEDOGS_MAX_MEETINGS="80"
THEDOGS_CONCURRENCY="5"
THEDOGS_TIME_ZONE="Australia/Sydney"
THEDOGS_BACKFILL_FROM="2006-08-01"

# Public Victoria/GRV source for richer VIC fields, Watchdog tips, results, and
# replay IDs. The Dogs remains the national baseline for all-Australia coverage.
WATCHDOG_PROVIDER_ENABLED="true"
WATCHDOG_BASE_URL="https://watchdog.grv.org.au"
WATCHDOG_MAX_MEETINGS="40"
WATCHDOG_CONCURRENCY="4"
WATCHDOG_FETCH_TIMEOUT_MS="30000"

# Prototype-only public FastTrack fallback for the demo race feed. Topaz remains
# the licensed production feed where available.
FASTTRACK_PROTOTYPE_ENABLED="true"
FASTTRACK_BASE_URL="https://fasttrack.grv.org.au"
FASTTRACK_MAX_MEETINGS="1"

# Self-hosted LiveKit server for in-app voice/video calls. Required when call
# routes are enabled for users; keep API secrets server-only. The LiveKit
# server must POST webhooks to <app>/api/livekit/webhook signed with the same
# API key (see deploy/livekit/livekit.yaml).
LIVEKIT_URL="wss://livekit.example.com"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret"
# Browser connect origin for CSP; same host as LIVEKIT_URL.
NEXT_PUBLIC_LIVEKIT_URL="wss://your-livekit-host"

# Demo marketplace media. Keep enabled for pre-launch/dev; set false for live.
NEXT_PUBLIC_ENABLE_DEMO_LISTING_MEDIA="true"
NEXT_PUBLIC_ENABLE_DEMO_ACCOUNT="true"

# Optional smoke-test target
SMOKE_BASE_URL="http://localhost:3000"
